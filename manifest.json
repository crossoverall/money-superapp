      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Remaining Money",
      "short_name": "Remaining",
      "description": "Calculate salary deductions & net remaining money",
      "url": "./index.html#remaining-money",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Portfolio Rebalance",
      "short_name": "Rebalance",
      "description": "Portfolio rebalancing and DCA calculator",
      "url": "./index.html#rebalance",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Income Tax",
      "short_name": "Tax",
      "description": "Thai Personal Income Tax calculator",
      "url": "./index.html#tax-calculator-base",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
