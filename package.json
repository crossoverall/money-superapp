{
  "name": "money-superapp",
  "version": "2.5.77",
  "description": "Zero-build, offline-first personal finance toolkit for Thailand",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:budget": "node --test tests/asset-budget.test.mjs",
    "test:e2e": "node --test tests/e2e-browser-journeys.test.mjs",
    "test:visual": "node --test tests/visual-regression.test.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "biome check js/ scripts/ tests/",
    "format": "biome format --write js/ scripts/ tests/",
    "bump": "node scripts/bump.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "finance",
    "tax",
    "dca",
    "rebalance",
    "debt",
    "pwa",
    "thailand"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
